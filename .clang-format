# Formatting for the C, C++ and eBPF sources.
#
# Close to the Linux kernel style the code was already written in -- 8-column
# indent, braces on their own line for functions, `else` cuddled to the
# closing brace -- with two deliberate departures, both requested:
#
#   - spaces, not tabs. Tab width is a per-viewer setting, so a tabbed file
#     renders differently for different people; spaces render the same
#     everywhere.
#   - 100 columns rather than 80. The names here are short by house style,
#     but the types (std::vector<uint8_t>, struct bpf_map_def) are not, and
#     80 forces wrapping that hurts more than the width costs.
#
# Not applied wholesale to the existing tree: reformatting every file would
# bury real changes under whitespace. Run it on what you touch.
---
Language: Cpp
BasedOnStyle: LLVM

UseTab: Never
IndentWidth: 8
TabWidth: 8
ContinuationIndentWidth: 8
ColumnLimit: 100

# Functions get a brace on their own line; everything else cuddles. This is
# the kernel convention, and the codebase already follows it.
BreakBeforeBraces: Linux

# CLAUDE.md requires braces on every if/else body, including single
# statements. clang-format cannot add them, but it must not remove them.
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
InsertBraces: true

# `int *p`, not `int* p` -- the C convention, and what the tree uses.
PointerAlignment: Right
DerivePointerAlignment: false

AlignAfterOpenBracket: Align
AlignEscapedNewlines: Left
AlignTrailingComments: true
BinPackArguments: true
BinPackParameters: true
IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements

# Includes are written relative to the source root and grouped: our own
# headers first, then system. Sorting within a group is safe; merging the
# groups is not, so the categories are pinned.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

AccessModifierOffset: -8
NamespaceIndentation: None
FixNamespaceComments: true
