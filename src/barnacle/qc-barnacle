#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""qc-barnacle - find processes worth caching for, and attach to them.

Barnacle is the part that decides WHERE the cache attaches. It runs on the
host, looks at /proc, works out which processes match the config and whether
each can actually be hooked, and then shells out to qc-inject for the ones
that can.

It reads /proc, matches strings, and runs a subprocess. There is no reason for
that to be C++ -- it does no protocol work, touches no BPF map, and is not on
any hot path. Python keeps it readable and keeps the C++ confined to the
components that genuinely need it (the daemon, the injected agent, the eBPF).

Discovery looks straight at /proc rather than asking a container runtime.
Given the host PID namespace, processes inside containers appear there like
any other -- a container is a cgroup and some namespaces, not a separate
process table -- so this works the same under docker, podman and containerd,
and on a bare host.

Deciding whether an attach would WORK is the useful half, because several
things have to line up and each has silently broken this project before:

  - a TLS library has to be mapped, and it has to be OpenSSL. Go and Java do
    TLS in-process, with no libssl to hook at all.
  - the symbols matter, not just the library. The mysql CLI calls
    SSL_read/SSL_write; CPython's _ssl calls only the _ex variants. Hooking
    one family attaches cleanly to a process using the other and then never
    fires -- indistinguishable from "the cache does not work".
  - libssl is usually dlopen'd on first use, so a valid target looks empty
    until it has connected at least once.
  - and there has to be a live connection to the database, or there is
    nothing to cache.

Saying which of those failed is the difference between a useful tool and one
that reports success and does nothing.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys

PROC = "/proc"

# Verdicts, and the actionable explanation for each. A bare enum name is not
# useful; these are the things that actually go wrong.
ATTACHABLE = "attachable"
NO_TLS = "no-tls-library"
UNSUPPORTED_TLS = "unsupported-tls"
NO_SYMBOLS = "no-ssl-symbols"
NO_DB_CONN = "no-database-conn"

EXPLAIN = {
    NO_TLS: (
        "no TLS library mapped yet. Usually means the process has not opened\n"
        "      a connection -- libssl is normally dlopen'd on first use.\n"
        "      Re-run once it has connected."
    ),
    UNSUPPORTED_TLS: (
        "mapped TLS library has no OpenSSL entry points to hook.\n"
        "      Go and Java do TLS in-process and are out of scope."
    ),
    NO_SYMBOLS: (
        "libssl is mapped but exports neither SSL_read/SSL_write nor the _ex\n"
        "      variants -- likely stripped or statically linked."
    ),
    NO_DB_CONN: (
        "attachable, but no established connection to the database port.\n"
        "      Nothing to cache until it talks to the database."
    ),
}


# --- config ---------------------------------------------------------------
#
# Plain `key = value` in `[section]` blocks. No YAML or JSON dependency for
# something this small, and it stays readable in a diff.


class Target:
    def __init__(self, name):
        self.name = name
        self.comm = ""
        self.cmdline = ""
        self.container = ""
        self.mysql_port = 3306
        self.statements = ""
        self.ttl = 60

    def matches_nothing(self):
        return not (self.comm or self.cmdline or self.container)


class Config:
    def __init__(self):
        self.targets = []
        self.valkey_host = "valkey"
        self.valkey_port = 6379


def load_config(path):
    """Parse the config file. Raises ValueError with a line number on error."""
    cfg = Config()
    cur = None

    with open(path, encoding="utf-8") as fh:
        for lineno, raw in enumerate(fh, 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue

            if line.startswith("[") and line.endswith("]"):
                inner = line[1:-1].strip()
                if not inner.startswith("target "):
                    raise ValueError("%s:%d: unknown section %r" % (path, lineno, inner))
                cur = Target(inner[len("target "):].strip())
                cfg.targets.append(cur)
                continue

            if "=" not in line:
                raise ValueError("%s:%d: expected key = value" % (path, lineno))
            key, val = (p.strip() for p in line.split("=", 1))

            if cur is None:
                if key == "valkey_host":
                    cfg.valkey_host = val
                elif key == "valkey_port":
                    cfg.valkey_port = int(val)
                else:
                    raise ValueError("%s:%d: unknown key %r" % (path, lineno, key))
                continue

            if key in ("comm", "cmdline", "container", "statements"):
                setattr(cur, key, val)
            elif key == "mysql_port":
                cur.mysql_port = int(val)
            elif key == "ttl":
                cur.ttl = int(val)
            else:
                raise ValueError("%s:%d: unknown key %r" % (path, lineno, key))

    # A target with no matchers would match every process on the host. Reject
    # it here rather than discovering that by attaching to init.
    for t in cfg.targets:
        if t.matches_nothing():
            raise ValueError("target %r has no matchers" % t.name)
    if not cfg.targets:
        raise ValueError("%s: no targets defined" % path)
    return cfg


# --- reading /proc --------------------------------------------------------


def read_file(path, limit=1 << 20):
    try:
        with open(path, "rb") as fh:
            return fh.read(limit)
    except OSError:
        return b""


def read_comm(pid):
    return read_file("%s/%d/comm" % (PROC, pid), 4096).decode("utf-8", "replace").strip()


def read_cmdline(pid):
    # NUL-separated; the trailing NUL leaves an empty final field.
    raw = read_file("%s/%d/cmdline" % (PROC, pid), 65536)
    return " ".join(raw.decode("utf-8", "replace").split("\0")).strip()


CGROUP_ID = re.compile(r"(?:docker[-/]|libpod-|cri-containerd[-:])([0-9a-f]{12,64})")


def read_container(pid):
    """Recover a container id from the process's cgroup, if it has one.

    Returns (id, kind). Empty id means the process is on the host, or that its
    cgroup path says nothing -- which is what happens when we ourselves run in
    a cgroup namespace rather than on the host.
    """
    txt = read_file("%s/%d/cgroup" % (PROC, pid), 65536).decode("utf-8", "replace")
    for line in txt.splitlines():
        m = CGROUP_ID.search(line)
        if m:
            cid = m.group(1)
            kind = "podman" if "libpod-" in line else "docker"
            if "cri-containerd" in line:
                kind = "containerd"
            return cid, kind
    return "", "host"


def in_cgroup_namespace():
    """True when our own cgroup path tells us nothing.

    A container that has its own cgroup namespace sees `0::/` for everything,
    including itself, so no container id can be recovered from /proc for ANY
    process -- ours or a target's. That is the normal case when barnacle runs
    inside a container rather than on the host.
    """
    txt = read_file("%s/self/cgroup" % PROC, 65536).decode("utf-8", "replace")
    for line in txt.splitlines():
        if CGROUP_ID.search(line):
            return False
    return True


def container_names():
    """Map container id -> name, best effort.

    Only so the report can say `vebpf-bpf` instead of a 64-character hash.
    Discovery itself never needs this, so a missing or failing docker CLI is
    not an error.
    """
    names = {}
    try:
        out = subprocess.run(
            ["docker", "ps", "--no-trunc", "--format", "{{.ID}} {{.Names}}"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return names
    if out.returncode != 0:
        return names
    for line in out.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2:
            names[parts[0]] = parts[1]
    return names


def detect_tls(pid):
    """Which TLS library the process has mapped. Returns (kind, path)."""
    maps = read_file("%s/%d/maps" % (PROC, pid), 4 << 20).decode("utf-8", "replace")
    found = ("none", "")

    for line in maps.splitlines():
        # The path is the last field, and only absolute paths are files.
        parts = line.rsplit(" ", 1)
        if len(parts) != 2:
            continue
        path = parts[1].strip()
        if not path.startswith("/"):
            continue

        if "libssl.so" in path:
            return "openssl", path  # supported: stop here
        if "libgnutls.so" in path:
            found = ("gnutls", path)
        elif "libnss3.so" in path or "libssl3.so" in path:
            found = ("nss", path)
    return found


def detect_symbols(pid, libssl_path):
    """Which SSL entry-point families the mapped library exports.

    Read through /proc/<pid>/root so a path that only exists inside the
    container still resolves from the host.

    A plain byte scan for the symbol names, rather than parsing .dynsym: crude,
    but it needs no ELF library, works for both ELF classes, and only ever
    answers a yes/no question.
    """
    if not libssl_path:
        return False, False
    blob = read_file("%s/%d/root%s" % (PROC, pid, libssl_path), 16 << 20)
    if not blob:
        return False, False
    classic = b"SSL_read" in blob and b"SSL_write" in blob
    ex = b"SSL_read_ex" in blob and b"SSL_write_ex" in blob
    return classic, ex


def socket_inodes(pid):
    inodes = set()
    fddir = "%s/%d/fd" % (PROC, pid)
    try:
        entries = os.listdir(fddir)
    except OSError:
        return inodes
    for e in entries:
        try:
            link = os.readlink(os.path.join(fddir, e))
        except OSError:
            continue
        if link.startswith("socket:["):
            inodes.add(link[len("socket:["):-1])
    return inodes


TCP_ESTABLISHED = "01"


def count_db_connections(pid, port):
    """Established TCP connections from this process to `port`.

    Matched by inode: /proc/<pid>/fd gives the process's socket inodes, and
    /proc/<pid>/net/tcp lists connections in ITS network namespace. Reading the
    per-process net/tcp rather than the host's is what makes this correct for
    containers, which usually have their own.
    """
    inodes = socket_inodes(pid)
    if not inodes:
        return 0

    count = 0
    for proto in ("tcp", "tcp6"):
        txt = read_file("%s/%d/net/%s" % (PROC, pid, proto), 4 << 20)
        for line in txt.decode("utf-8", "replace").splitlines()[1:]:
            f = line.split()
            if len(f) < 10 or f[3] != TCP_ESTABLISHED:
                continue
            rem = f[2].rsplit(":", 1)
            if len(rem) != 2 or int(rem[1], 16) != port:
                continue
            if f[9] in inodes:
                count += 1
    return count


# --- discovery ------------------------------------------------------------


class Process:
    def __init__(self, pid):
        self.pid = pid
        self.comm = ""
        self.cmdline = ""
        self.container = ""
        self.container_kind = "host"
        self.tls = "none"
        self.libssl_path = ""
        self.has_classic = False
        self.has_ex = False
        self.db_connections = 0
        self.verdict = NO_TLS
        self.target = None
        # A container filter was configured but could not be checked; see
        # discover().
        self.container_unattributable = False

    @property
    def where(self):
        if self.container:
            return self.container
        return "?" if self.container_unattributable else "host"

    @property
    def symbols(self):
        if self.has_classic and self.has_ex:
            return "both"
        if self.has_classic:
            return "classic"
        if self.has_ex:
            return "_ex"
        return "-"


def ci_contains(hay, needle):
    """Case-insensitive substring match; an empty needle matches anything."""
    return needle.lower() in hay.lower() if needle else True


def ci_equals(hay, needle):
    """Case-insensitive exact match; an empty needle matches anything.

    Used for comm, which is a short fixed name rather than a phrase. Substring
    matching there is actively wrong: `comm = mysql` would also match mysqld,
    so a config meaning "the mysql CLI" would try to attach to the server.
    """
    return hay.lower() == needle.lower() if needle else True


def discover(cfg):
    names = container_names()
    # When no process can be attributed to a container, a container filter
    # cannot be applied. Ignoring it would silently attach to things the
    # config did not ask for; honouring it would match nothing at all and
    # look like "no such process". Match, and say so in the report.
    blind = in_cgroup_namespace()
    out = []

    for entry in sorted(os.listdir(PROC)):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == os.getpid():
            continue

        comm = read_comm(pid)
        if not comm:
            continue  # exited between listdir and read
        cmdline = read_cmdline(pid)
        cid, kind = read_container(pid)
        cname = names.get(cid, cid[:12] if cid else "")

        for t in cfg.targets:
            if not ci_equals(comm, t.comm):
                continue
            if not ci_contains(cmdline, t.cmdline):
                continue
            # Match the container by name or by id prefix, so either works.
            if t.container and not blind and not (
                ci_contains(cname, t.container) or cid.startswith(t.container)
            ):
                continue

            p = Process(pid)
            p.comm, p.cmdline = comm, cmdline
            p.container, p.container_kind = cname, kind
            p.container_unattributable = bool(t.container) and blind
            p.target = t
            out.append(p)
            break
    return out


def analyse(p):
    p.tls, p.libssl_path = detect_tls(p.pid)

    if p.tls == "none":
        p.verdict = NO_TLS
        return
    if p.tls != "openssl":
        p.verdict = UNSUPPORTED_TLS
        return

    p.has_classic, p.has_ex = detect_symbols(p.pid, p.libssl_path)
    if not (p.has_classic or p.has_ex):
        p.verdict = NO_SYMBOLS
        return

    p.db_connections = count_db_connections(p.pid, p.target.mysql_port)
    p.verdict = ATTACHABLE if p.db_connections else NO_DB_CONN


# --- attaching ------------------------------------------------------------


def inject_path():
    """Where qc-inject lives.

    Prefer one next to this script's build output, so running from a source
    tree works without installing anything; fall back to PATH.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (
        os.path.join(here, "qc-inject"),
        os.path.join(here, "..", "build", "qc-inject"),
        os.path.join(os.getcwd(), "build", "qc-inject"),
    ):
        cand = os.path.normpath(cand)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return "qc-inject"


def attach_one(p, dry_run, verbose):
    """Shell out to qc-inject.

    A subprocess rather than a library call: injection maps the agent into the
    target, and doing that from inside our own address space is not the
    supported path.
    """
    if dry_run:
        print("      [dry-run] would attach the agent to pid %d" % p.pid)
        return True

    cmd = [inject_path(), str(p.pid)]
    try:
        r = subprocess.run(
            cmd, capture_output=not verbose, text=True, timeout=120
        )
    except FileNotFoundError:
        print("      qc-inject not found (try ./build)", file=sys.stderr)
        return False
    except subprocess.SubprocessError as e:
        print("      attach failed for pid %d: %s" % (p.pid, e), file=sys.stderr)
        return False

    if r.returncode == 0:
        print("      attached the agent to pid %d" % p.pid)
        return True
    print("      attach failed for pid %d" % p.pid, file=sys.stderr)
    return False


# --- reporting ------------------------------------------------------------

ROW = "%-7s %-14s %-16s %-8s %-8s %-6s %s"


def report(procs, explain):
    print(ROW % ("PID", "COMM", "WHERE", "TLS", "SYMBOLS", "CONNS", "VERDICT"))
    print(ROW % ("-" * 7, "-" * 14, "-" * 16, "-" * 8, "-" * 8, "-" * 6, "-" * 16))

    for p in procs:
        print(ROW % (p.pid, p.comm[:14], p.where[:16], p.tls, p.symbols,
                     p.db_connections, p.verdict))
        if not explain:
            continue
        if p.verdict == ATTACHABLE:
            print("      ready: %s, %d connection(s) to port %d"
                  % (p.libssl_path, p.db_connections, p.target.mysql_port))
        else:
            print("      " + EXPLAIN[p.verdict])

    if not procs:
        print("(no processes matched the config)")
        return

    if any(p.container_unattributable for p in procs):
        print("\nWHERE is '?' for processes whose container could not be "
              "determined: this\nprocess is in a cgroup namespace, so /proc "
              "reports no container for anything.\nThe config's `container` "
              "filter could not be applied to those rows. Run barnacle\non "
              "the host to filter by container.")


# --- entry point ----------------------------------------------------------


def daemon_path():
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (
        os.path.join(here, "qc-daemon"),
        os.path.join(here, "..", "build", "qc-daemon"),
        os.path.join(os.getcwd(), "build", "qc-daemon"),
    ):
        cand = os.path.normpath(cand)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return "qc-daemon"


def make_parser():
    # Python 3.14's argparse colorizes help by default. Turn that off through
    # argparse's own parameter rather than an environment variable, and only
    # where it exists -- passing it on 3.13 is a TypeError.
    kwargs = {}
    if sys.version_info >= (3, 14):
        kwargs["color"] = False

    ap = argparse.ArgumentParser(
        prog="qc-barnacle",
        description="Find processes worth caching for, and attach to them.",
        epilog="Runs on the host. Container processes are visible through "
               "/proc like any others, so no container runtime is required.",
        **kwargs,
    )
    ap.add_argument("-c", "--config", default="config/barnacle.conf",
                    metavar="PATH", help="config file (default: %(default)s)")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="report what would happen, change nothing")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("command", choices=("list", "analyze", "attach", "run"),
                    help="list: matching processes and their verdicts; "
                         "analyze: as above, with reasoning; "
                         "attach: attach the agent to everything attachable; "
                         "run: attach, then run the daemon in the foreground")
    return ap


def main(argv=None):
    args = make_parser().parse_args(argv)

    try:
        cfg = load_config(args.config)
    except (OSError, ValueError) as e:
        print("qc-barnacle: %s" % e, file=sys.stderr)
        return 1

    procs = discover(cfg)
    for p in procs:
        analyse(p)

    if args.command in ("list", "analyze"):
        report(procs, explain=args.command == "analyze")
        return 0

    report(procs, explain=False)
    ready = [p for p in procs if p.verdict == ATTACHABLE]
    if not ready:
        print("\nnothing attachable; run 'analyze' for the reasoning",
              file=sys.stderr)
        return 1

    print()
    ok = 0
    for p in ready:
        if attach_one(p, args.dry_run, args.verbose):
            ok += 1
    print("\nattached %d of %d" % (ok, len(ready)))

    if args.command != "run":
        return 0 if ok else 1

    # The statement list is a per-target setting, but the daemon owns one
    # shared cache. Use the first target's list and say so, rather than
    # silently picking one.
    lists = {p.target.statements for p in ready if p.target.statements}
    if len(lists) > 1:
        print("qc-barnacle: targets disagree on the statement list; using %s"
              % sorted(lists)[0], file=sys.stderr)
    if not lists:
        print("qc-barnacle: no statement list configured", file=sys.stderr)
        return 1

    cmd = [daemon_path(), "-l", sorted(lists)[0]]
    if args.verbose:
        cmd.append("-v")
    print("\nrunning: %s\n" % " ".join(cmd))
    try:
        return subprocess.call(cmd)
    except FileNotFoundError:
        print("qc-barnacle: qc-daemon not found (try ./build)", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
